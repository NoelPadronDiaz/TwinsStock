PORT=3000

# Neon (or any managed Postgres): paste the connection string here.
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Used only if DATABASE_URL is not set (e.g. local Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=twinsstock
DB_PASSWORD=twinsstock
DB_DATABASE=twinsstock
DB_SSL=false

CORS_ORIGIN=http://localhost:5173

# JWT: cambia JWT_SECRET por una cadena aleatoria larga antes de desplegar.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h

# Usuario admin inicial: solo se crea si la tabla de usuarios está vacía.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
