# Copy to .env.prod and fill in before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build
# DATABASE_URL, JWT_SECRET, CORS_ORIGIN and ADMIN_PASSWORD are required —
# Compose refuses to start with a clear error if any is missing.

# Paste your Neon (or other managed Postgres) connection string here.
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The origin the frontend is actually served from, e.g. https://stock.example.com
CORS_ORIGIN=

JWT_SECRET=
JWT_EXPIRES_IN=12h

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Port the frontend (nginx) publishes on the host.
APP_PORT=8080

# Only needed if you point DATABASE_URL at the optional local-db profile
# instead of Neon (see Readme.md): postgresql://twinsstock:twinsstock@db:5432/twinsstock
# DB_SSL=false
