# Copy to .env.docker and fill in before running:
#   docker compose --env-file .env.docker up --build
# Only the backend/frontend/db *application* secrets live here — DB_HOST,
# DB_USERNAME, etc. are fixed to twinsstock/twinsstock/twinsstock directly in
# docker-compose.yml, since they're not real secrets for local dev.

JWT_SECRET=dev-secret-change-me

# Creates the initial admin user on first boot (only if the users table is
# empty — safe to leave set on every restart).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Secret for the kiosk QR clock-in tokens (separate from JWT_SECRET, any
# string works for local dev).
CLOCK_QR_SECRET=dev-clock-secret-change-me
